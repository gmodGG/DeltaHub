local LastDeltaError = 0

local function safeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[Delta]", err)
        local now = tick()
        if now - LastDeltaError >= 3 then
            LastDeltaError = now
            local msg = tostring(err)
            if #msg > 120 then msg = msg:sub(1, 120) .. "..." end
            DeltaNotify(msg, 5)
        end
    end
    return ok
end

